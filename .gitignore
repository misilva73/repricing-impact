# Credentials — DO NOT COMMIT
secrets.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv
venv/
.ipynb_checkpoints

# Data (not checked into git) — build-time DuckDB/parquet intermediates only.
data/
# …but the published static JSON under site/data/ MUST be committed so the
# GitHub Pages site has its data. (Aggregates only; no secrets — see plan §Deploy.)
!site/data/
!site/data/**

# Build-time precompute intermediates under site/data/ are NOT published:
# the .build/ DuckDB file and any parquet projections (divergence_tx, etc.).
# (These rules come AFTER the site/data un-ignore above so they win.)
site/data/.build/
*.duckdb
*.duckdb.wal
*.parquet

# Offline-dev fixtures generated by scripts/make_fixtures.py — never committed.
fixtures_scratch/

# Build-time label enrichment caches (expansion plan §4.2) — raw per-source pulls
# and the merged contract_labels.parquet. Never committed; only the tiny label
# slice inlined into site/data/** by precompute is published.
label_cache/

# Local agent guidance — the canonical guide is AGENTS.md (committed); CLAUDE.md
# is just a personal @-import pointer to it and is not checked in.
CLAUDE.md

# OS
.DS_Store
